{
  "name": "casplo2gpx-web",
  "version": "1.0.0",
  "description": "Web app per scaricare e convertire il Catasto Speleologico Lombardo in GPX",
  "private": true,
  "scripts": {
    "serve":     "npx serve .",
    "lint":      "eslint js/ --ext .js",
    "format":    "prettier --write js/ css/ index.html",
    "prebuild":  "rm -rf dist && mkdir -p dist",
    "build":     "esbuild js/app.js --bundle --minify --sourcemap --outfile=dist/bundle.js",
    "build:dev": "esbuild js/app.js --bundle --sourcemap --outfile=dist/bundle.js",
    "test":      "jest --experimental-vm-modules"
  },
  "devDependencies": {
    "esbuild":                    "^0.19.0",
    "eslint":                     "^8",
    "jest":                       "^29",
    "@jest/globals":              "^29",
    "jest-environment-jsdom":     "^29",
    "prettier":                   "^3",
    "serve":                      "^14"
  },
  "dependencies": {
    "dompurify": "^3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {}
  }
}
