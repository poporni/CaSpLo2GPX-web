{
  "name": "casplo2gpx-web",
  "version": "1.0.2",
  "description": "Web app per scaricare e convertire il Catasto Speleologico Lombardo in GPX",
  "private": true,
  "type": "module",
  "scripts": {
    "serve":     "npx serve .",
    "lint":      "eslint js/ scripts/ --ext .js",
    "format":    "prettier --write js/ css/ index.html",
    "prebuild":  "rm -rf dist && mkdir -p dist",
    "build":     "esbuild js/app.js --bundle --minify --sourcemap=external --outfile=dist/bundle.js --loader:.css=copy",
    "build:dev": "esbuild js/app.js --bundle --sourcemap=inline --outfile=dist/bundle.js",
    "test":      "node --experimental-vm-modules node_modules/.bin/jest",
    "backup":    "node scripts/backup-openkis.js",
    "backup:full": "node scripts/backup-openkis.js --include-images"
  },
  "dependencies": {
    "dompurify":    "^3",
    "leaflet":      "^1.9.4",
    "leaflet-draw": "^1.0.2"
  },
  "devDependencies": {
    "esbuild":                "^0.19.0",
    "eslint":                 "^8",
    "jest":                   "^29",
    "@jest/globals":          "^29",
    "jest-environment-jsdom": "^29",
    "prettier":               "^3",
    "serve":                  "^14"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {},
    "moduleNameMapper": {
      "^(\\.\\.?/.+)\\.js$": "$1"
    }
  }
}
